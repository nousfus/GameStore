    {
      "name": "findByDate",
      "signature": "public abstract java.util.List<com.example.gamestore.entity.Orders> com.example.gamestore.dao.OrdersDao.findByDate(java.time.LocalDate,java.time.LocalDate)",
      "query": {
        "query": "select o from Orders o where order_date between :startDate and :endDate"
      }
    },
    {
      "name": "findByUsername",
      "signature": "public abstract java.util.List<com.example.gamestore.entity.Orders> com.example.gamestore.dao.OrdersDao.findByUsername(java.lang.String)",
      "query": {
        "query": "SELECT o FROM Orders o WHERE o.username = :username"
      }
    },
    {
      "name": "findByUsernameAndStatus",
      "signature": "public abstract java.util.List<com.example.gamestore.entity.Orders> com.example.gamestore.dao.OrdersDao.findByUsernameAndStatus(java.lang.String,java.lang.String)",
      "query": {
        "query": "select o from Orders o where o.username = :username and o.status = :status"
      }
    },
    {
      "name": "revenueByDate",
      "signature": "public abstract java.util.List<java.lang.Object[]> com.example.gamestore.dao.OrdersDao.revenueByDate(java.time.LocalDate,java.time.LocalDate)",
      "query": {
        "query": "SELECT\n    order_date AS revenueDate,\n    SUM(total_amount) AS revenue\nFROM Orders\nWHERE status = 'Paid'\n  AND order_date BETWEEN :startDate AND :endDate\nGROUP BY order_date\nORDER BY order_date\n"
      }
    },
