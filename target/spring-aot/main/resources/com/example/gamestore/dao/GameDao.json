    },
    {
      "name": "findByDeveloper_Developerid",
      "signature": "public abstract java.util.List<com.example.gamestore.entity.Game> com.example.gamestore.dao.GameDao.findByDeveloper_Developerid(java.lang.String)",
      "query": {
        "query": "SELECT g FROM Game g WHERE g.developer.developerid = :id"
      }
    },
    {
      "name": "findByGameNameContainingIgnoreCase",
      "signature": "public abstract org.springframework.data.domain.Page<com.example.gamestore.entity.Game> com.example.gamestore.dao.GameDao.findByGameNameContainingIgnoreCase(java.lang.String,org.springframework.data.domain.Pageable)",
      "query": {
        "query": "SELECT g FROM Game g WHERE LOWER(g.GameName) LIKE LOWER(CONCAT('%', :keyword, '%'))",
        "count-query": "SELECT count(g) FROM Game g WHERE LOWER(g.GameName) LIKE LOWER(CONCAT('%', :keyword, '%'))"
      }
    },
    {
      "name": "findMostExpensiveGames",
      "signature": "public abstract java.util.List<com.example.gamestore.entity.Game> com.example.gamestore.dao.GameDao.findMostExpensiveGames()",
      "query": {
        "query": "SELECT g FROM Game g WHERE g.price = (SELECT MAX(g2.price) FROM Game g2)"
      }
    },
    {
      "name": "findTop3ByRating",
      "signature": "public abstract java.util.List<com.example.gamestore.entity.Game> com.example.gamestore.dao.GameDao.findTop3ByRating(int)",
      "query": {
        "query": "SELECT g FROM Game g WHERE g.rating = :rating"
      }
